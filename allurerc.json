{
  "name": "RealWorld Playwright Demo",
  "output": "./allure-report",
  "historyPath": "./allure-history.jsonl",
  "appendHistory": true,
  "categories": {
    "rules": [
      {
        "name": "Known bugs — FK constraint",
        "matchers": {
          "statuses": ["failed"],
          "message": ".*delete article with comment.*"
        }
      },
      {
        "name": "Product defects",
        "matchers": {
          "statuses": ["failed"]
        }
      },
      {
        "name": "Test defects",
        "matchers": {
          "statuses": ["broken"]
        }
      }
    ]
  },
  "plugins": {
    "awesome": {
      "options": {
        "singleFile": false,
        "reportLanguage": "en"
      }
    }
  }
}