# See http://help.github.com/ignore-files/ for more about ignoring files.

# ==========================================
# Dependencies
# ==========================================
/node_modules
/dist
/tsconfig.tsbuildinfo

# ==========================================
# IDEs and editors
# ==========================================
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
# We commit shared workspace settings but nothing machine-specific.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ==========================================
# Next.js build output
# ==========================================
.next
/out

# ==========================================
# Environment variables
# ==========================================
# .env is auto-generated by `npm run initialize:env` from .env.example.
# Never commit real secrets — only commit .env.example with placeholder values.
.env
.env.local
.env*.local

# ==========================================
# OS / system
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/test-results/

# ==========================================
# Prisma — generated / runtime databases
# ==========================================
# base.sqlite is the seed database committed to the repo (used as a template).
# database.sqlite is copied from base.sqlite by initialize:database — local only.
# test.sqlite is generated by globalSetup before each test run — local only.
/prisma/database.sqlite
/prisma/test.sqlite
/prisma/*.db-journal

# ==========================================
# Playwright
# ==========================================
# Playwright HTML report — generated after each test run
/playwright-report/
# Test artifacts: screenshots, videos, traces
/test-results/
# Allure — raw results and generated report
/allure-results/
/allure-report/
# Allure 3 history file — generated locally, not committed
/allure-history/
# Allure report v3 temp folder — generated locally
/allure-report-v3/

# ==========================================
# Auth state
# ==========================================
# Contains session tokens — never commit.
# Keep the folder in the repo via .gitkeep but ignore the JSON files themselves.
/tests/auth/*.json
!/tests/auth/.gitkeep